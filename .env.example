# Public Supabase configuration (safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service key. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Judge0-compatible API. Self-hosted Judge0 is recommended for production.
JUDGE0_URL=https://your-judge0-host.example.com
JUDGE0_API_KEY=
# Optional header name used by your provider, e.g. X-Auth-Token or X-RapidAPI-Key.
JUDGE0_API_KEY_HEADER=X-Auth-Token

# Optional overrides for your Judge0 deployment's language IDs.
JUDGE0_PYTHON_LANGUAGE_ID=71
JUDGE0_CPP_LANGUAGE_ID=54
JUDGE0_JAVA_LANGUAGE_ID=62

# If Judge0 is not configured, execution falls back to Wandbox automatically.
# These are optional overrides for that fallback.
WANDBOX_URL=https://wandbox.org/api
WANDBOX_PYTHON_COMPILER=cpython-3.11.10
WANDBOX_CPP_COMPILER=gcc-13.2.0
WANDBOX_JAVA_COMPILER=openjdk-jdk-21+35

# Comma-separated origins allowed to call API routes. Empty means same-origin only.
ALLOWED_ORIGINS=
